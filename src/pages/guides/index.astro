---
import { GUIDES } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="HVAC Field Guides — Read Quotes, SEER2 & R-22 | HVAC Second Opinion"
  description="Six original homeowner field guides covering HVAC quotes, the $5,000 rule, R-22 phase-out, SEER2 ratings, contractor vetting, and failure signs."
>
  <nav aria-label="Breadcrumb" class="breadcrumb">
    <a href="/">Calculator</a> / <span>Field Guides</span>
  </nav>

  <h1>HVAC Quote &amp; Repair Field Guides</h1>
  <p class="intro-lead">
    Every guide below includes worked homeowner arithmetic and verified federal references from the U.S. EPA, Department of Energy (DOE), ENERGY STAR, and the IRS.
  </p>

  <div class="guides-grid">
    {GUIDES.map((guide) => (
      <a class="guide-link-row" href={guide.href}>
        <span class="guide-badge">{guide.badge}</span>
        <div class="guide-link-title">{guide.title}</div>
        <p class="field-note" style="margin-bottom: 0;">{guide.summary}</p>
      </a>
    ))}
  </div>

  <div style="margin-top: 2rem;">
    <a class="btn btn-primary" href="/">Return to Calculator →</a>
  </div>
</BaseLayout>
